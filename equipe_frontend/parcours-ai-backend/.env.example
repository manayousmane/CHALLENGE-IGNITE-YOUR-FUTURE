# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Uniquement si ton projet utilise encore l'ancien système JWT (HS256).
# Project Settings > API > JWT Secret. Laisse vide si tu ne sais pas.
SUPABASE_JWT_SECRET=

# Connexion directe Postgres — Project Settings > Database > Connection string
# (utilise le "Connection pooling" en production, la connexion directe en dev)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Domaine du frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5173
